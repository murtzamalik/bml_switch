    },
    {
      "name": "05 — Payments",
      "description": "IFT uses live iMal SOAP when MOCK_IMAL=false. Header Idempotency-Key required (UUID).",
      "item": [
        {
          "name": "POST payment/ift",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "var stan = j.return && j.return.stan ? j.return.stan : j.stan;",
                  "if (stan) { pm.collectionVariables.set('stan', String(stan)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\",\n  \"toAccount\": \"{{toAccountIft}}\",\n  \"amount\": \"100.00\",\n  \"PurposeOfPayment\": \"FAM\",\n  \"Description\": \"AIS demo IFT\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/payment/ift",
            "description": "Same-bank transfer. Requires Idempotency-Key. Live SOAP when mockImal=false."
          }
        },
        {
          "name": "POST auth/otp/send (before IBFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.otpReference) { pm.collectionVariables.set('otpReference', j.otpReference); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"CNIC\": \"{{cnicExisting}}\",\n  \"MobileNo\": \"03001234567\",\n  \"purpose\": \"IBFT\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/send",
            "description": "Mock OTP = 1234 when MOCK_OTP=true."
          }
        },
        {
          "name": "POST auth/otp/verify (before IBFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.otpTicket) { pm.collectionVariables.set('otpTicket', j.otpTicket); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpReference\": \"{{otpReference}}\",\n  \"otp\": \"1234\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "POST payment/ibft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "var stan = j.return && j.return.stan ? j.return.stan : j.stan;",
                  "if (stan) { pm.collectionVariables.set('stan', String(stan)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\",\n  \"toIMD\": \"{{imd}}\",\n  \"toIBAN\": \"{{toIban}}\",\n  \"toAccount\": \"{{toAccountIbft}}\",\n  \"amount\": \"25.00\",\n  \"PurposeOfPayment\": \"FAM\",\n  \"Description\": \"AIS demo IBFT\",\n  \"otpTicket\": \"{{otpTicket}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/payment/ibft",
            "description": "Inter-bank. Run OTP send then verify first. Idempotency-Key required. Missing otpTicket → code 78."
          }
        }
      ]
    },
    {
      "name": "06 — Auth (optional / legacy)",
      "description": "Not required for AIS happy path. Static Bearer already authenticates all APIs.",
      "item": [
        {
          "name": "POST auth/token (optional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"appinsnap-sandbox\",\n  \"client_secret\": \"change_me_sandbox_secret\",\n  \"grant_type\": \"client_credentials\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/token",
            "description": "Optional. AIS should use staticToken on all APIs."
          }
        },
        {
          "name": "POST auth/refresh (optional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "POST auth/logout (optional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"revokeCustomerSession\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    }
  ]
}
