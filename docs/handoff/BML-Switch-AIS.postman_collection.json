              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stan\": \"{{stan}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/inquiry/ibft-status"
          }
        },
        {
          "name": "POST inquiry/mini-statement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/inquiry/mini-statement"
          }
        },
        {
          "name": "POST inquiry/statement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\",\n  \"fromDate\": \"2026-01-01\",\n  \"toDate\": \"2026-12-31\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/inquiry/statement"
          }
        },
        {
          "name": "POST inquiry/limits",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"{{fromAccount}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/inquiry/limits"
          }
        },
        {
          "name": "POST inquiry/receipt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
